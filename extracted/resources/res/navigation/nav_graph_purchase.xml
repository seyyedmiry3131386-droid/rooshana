<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_purchase"
    app:startDestination="@+id/start">
    <fragment
        android:name="ir.mservices.market.version2.fragments.StartDestinationFragment"
        android:id="@+id/start"/>
    <dialog
        android:name="ir.mservices.market.version2.fragments.dialog.PaymentRetryBottomDialogFragment"
        android:id="@+id/paymentRetry">
        <argument
            android:name="data"
            app:argType="ir.mservices.market.version2.fragments.dialog.DialogDataModel"
            app:nullable="false"/>
        <argument
            android:name="packageName"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="title"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="scenario"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/toPaymentRetry"
            app:destination="@+id/paymentRetry"/>
    </dialog>
    <dialog
        android:name="ir.mservices.market.version2.fragments.dialog.ProgressDialogFragment"
        android:id="@+id/progressDialog">
        <argument
            android:name="data"
            app:argType="ir.mservices.market.version2.fragments.dialog.DialogDataModel"
            app:nullable="false"/>
        <argument
            android:name="canceledOnTouchOutside"
            android:defaultValue="true"
            app:argType="boolean"/>
        <action
            android:id="@+id/toProgressDialog"
            app:destination="@+id/progressDialog"/>
    </dialog>
    <dialog
        android:name="ir.mservices.market.version2.fragments.dialog.InAppGatewayDialogFragment"
        android:id="@+id/inAppGateway">
        <argument
            android:name="data"
            app:argType="ir.mservices.market.version2.fragments.dialog.DialogDataModel"
            app:nullable="false"/>
        <argument
            android:name="gatewayData"
            app:argType="ir.mservices.market.gateway.GatewayBottomDialogFragment$GatewayData"
            app:nullable="false"/>
        <argument
            android:name="packageName"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/toInAppGateway"
            app:destination="@+id/inAppGateway"/>
    </dialog>
    <dialog
        android:name="ir.mservices.market.login.ui.LoginDialogFragment"
        android:id="@+id/anyLogin">
        <argument
            android:name="data"
            app:argType="ir.mservices.market.version2.fragments.dialog.DialogDataModel"
            app:nullable="false"/>
        <argument
            android:name="loginData"
            app:argType="ir.mservices.market.login.data.LoginData"
            app:nullable="false"/>
        <action
            android:id="@+id/toAnyLogin"
            app:destination="@+id/anyLogin"/>
    </dialog>
    <dialog
        android:name="ir.mservices.market.login.ui.PinLoginDialogFragment"
        android:id="@+id/pinLogin">
        <argument
            android:name="data"
            app:argType="ir.mservices.market.version2.fragments.dialog.DialogDataModel"
            app:nullable="false"/>
        <argument
            android:name="loginData"
            app:argType="ir.mservices.market.login.data.LoginData"
            app:nullable="false"/>
        <argument
            android:name="backLoginData"
            app:argType="ir.mservices.market.login.data.LoginData"
            app:nullable="false"/>
        <action
            android:id="@+id/toPinLogin"
            app:destination="@+id/pinLogin"/>
    </dialog>
</navigation>
