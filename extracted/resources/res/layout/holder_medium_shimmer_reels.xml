<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:tag="layout/holder_medium_shimmer_reels_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <ir.mservices.market.views.AlphaAnimationView
        android:id="@+id/card_skeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/horizontal_space_inner"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginRight="@dimen/horizontal_space_inner"
        android:layout_marginBottom="@dimen/space_m"
        android:layout_marginHorizontal="@dimen/horizontal_space_inner"
        android:layout_marginVertical="@dimen/space_m"/>
    <View
        android:id="@+id/divider"
        android:layout_width="@dimen/item_space"
        android:layout_height="1dp"/>
</LinearLayout>
