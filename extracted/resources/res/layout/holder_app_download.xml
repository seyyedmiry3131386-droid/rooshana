<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame_layout"
    android:tag="layout/holder_app_download_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/app_install_button_layout"
        android:paddingTop="@dimen/app_detail_download_button_top_padding"
        android:paddingBottom="@dimen/space_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/install_button_width"
        android:layoutDirection="locale">
        <ir.mservices.market.views.DownloadProgressBar
            android:id="@+id/download_progress_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/detail_download_button"
            android:progressDrawable="@drawable/detail_progress_download_white"
            android:mirrorForRtl="false"
            app:layout_constraintBottom_toBottomOf="@+id/low"
            app:layout_constraintEnd_toEndOf="@+id/app_install_button_layout"
            app:layout_constraintStart_toStartOf="@+id/app_install_button_layout"
            app:layout_constraintTop_toTopOf="@+id/low"
            style="?android:attr/progressBarStyleHorizontal"/>
        <ir.mservices.market.views.BigFillOvalButton
            android:id="@+id/high"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/app_install_button_layout"
            app:layout_constraintStart_toStartOf="@+id/app_install_button_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <ir.mservices.market.views.BigEmptyOvalButton
            android:id="@+id/low"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/app_install_button_layout"
            app:layout_constraintStart_toStartOf="@+id/app_install_button_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_small"
            android:id="@+id/has_guaranty"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/has_guaranty"
            android:layout_marginStart="@dimen/space_4"
            app:layout_constraintEnd_toEndOf="@+id/app_install_button_layout"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/app_install_button_layout"
            app:layout_constraintTop_toBottomOf="@+id/high"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_small"
            android:id="@+id/download_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:layout_constraintEnd_toEndOf="@+id/app_install_button_layout"
            app:layout_constraintStart_toStartOf="@+id/app_install_button_layout"
            app:layout_constraintTop_toBottomOf="@+id/low"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_small"
            android:id="@+id/half_price"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:layout_constraintEnd_toEndOf="@+id/app_install_button_layout"
            app:layout_constraintStart_toStartOf="@+id/app_install_button_layout"
            app:layout_constraintTop_toBottomOf="@+id/low"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
