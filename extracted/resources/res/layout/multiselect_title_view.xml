<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/select_view"
    android:tag="layout/multiselect_title_view_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/cancel"
        android:tag="binding_1"
        android:padding="@dimen/space_12"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/horizontal_space_outer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_close"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_medium"
        android:textStyle="bold"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/items_count"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/cancel"
        app:layout_constraintStart_toEndOf="@+id/cancel"
        app:layout_constraintTop_toTopOf="@+id/cancel"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_medium"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/remove_title"
        android:tag="binding_3"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/remove_item"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/horizontal_space_outer"
        android:paddingHorizontal="@dimen/space_8"
        app:bold="true"
        app:layout_constraintBottom_toBottomOf="@+id/cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cancel"/>
    <View
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
