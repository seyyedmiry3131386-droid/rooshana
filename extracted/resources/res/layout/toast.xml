<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:tag="layout/toast_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_large"
        android:id="@+id/title"
        android:paddingLeft="@dimen/space_m"
        android:paddingTop="@dimen/space_12"
        android:paddingRight="@dimen/space_m"
        android:paddingBottom="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/toast_padding"
        android:layout_marginRight="@dimen/toast_padding"
        android:layout_marginHorizontal="@dimen/toast_padding"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RtlGravity"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="@dimen/toast_icon"
        android:layout_height="@dimen/toast_icon"
        android:layout_marginStart="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
