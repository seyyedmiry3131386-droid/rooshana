<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-fa/holder_search_term_0"
    android:paddingLeft="@dimen/horizontal_space_outer"
    android:paddingRight="@dimen/horizontal_space_outer"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/suggestion_height">
    <RelativeLayout
        android:paddingLeft="@dimen/horizontal_space_inner"
        android:paddingTop="@dimen/margin_default_v2"
        android:paddingRight="@dimen/horizontal_space_inner"
        android:paddingBottom="@dimen/margin_default_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/margin_default_v2"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_large"
            android:id="@+id/title"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/margin_default_v2_double"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/icon"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            style="@style/RtlGravity.Center"/>
    </RelativeLayout>
</FrameLayout>
