<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/poster_blur"
        android:tag="layout/trailer_finished_playing_view_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.SeriesBackground
        android:id="@+id/poster_background"
        android:tag="layout/trailer_finished_playing_view_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="@+id/poster"
        app:layout_constraintStart_toStartOf="@+id/poster"
        app:layout_constraintTop_toTopOf="@+id/poster"/>
    <ir.mservices.market.views.ScreenshotView
        android:id="@+id/poster"
        android:tag="layout/trailer_finished_playing_view_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/space_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_huge"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:tag="layout/trailer_finished_playing_view_3"
        android:layout_width="@dimen/trailer_finished_playing_title_width"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:bold="true"
        app:layout_constraintBottom_toTopOf="@+id/play_button"
        app:layout_constraintEnd_toStartOf="@+id/poster"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/poster"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ir.mservices.market.views.BigFillOvalButton
        android:id="@+id/play_button"
        android:tag="layout/trailer_finished_playing_view_4"
        android:layout_width="@dimen/trailer_finished_playing_button_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_40"
        app:layout_constraintBottom_toBottomOf="@+id/poster"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"
        app:pb_state="button"
        app:pb_text="@string/movie_play"/>
    <FrameLayout
        android:id="@+id/back_layout"
        android:tag="layout/trailer_finished_playing_view_5"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/actionbar_start_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back"
            android:padding="@dimen/toolbar_back_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_back"/>
    </FrameLayout>
</merge>
