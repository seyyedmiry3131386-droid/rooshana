<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:tag="layout-fa/holder_complete_review_item_0"
    android:paddingLeft="@dimen/horizontal_space_outer"
    android:paddingRight="@dimen/horizontal_space_outer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/horizontal_space_outer">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="@dimen/horizontal_space_inner"
        android:paddingRight="@dimen/horizontal_space_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:layoutDirection="ltr">
        <ir.mservices.market.views.AppIconView
            android:id="@+id/app_icon"
            android:layout_width="@dimen/app_icon_size"
            android:layout_height="@dimen/app_icon_size"
            android:scaleType="fitXY"
            app:app_framed="false"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_medium"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@+id/app_title"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/category"
            app:layout_constraintLeft_toRightOf="@+id/more"
            app:layout_constraintRight_toLeftOf="@+id/app_icon"
            app:layout_constraintTop_toTopOf="@+id/app_icon"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ir.mservices.market.views.MyketAdInfoView
            android:id="@+id/ad_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/category"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toRightOf="@+id/category"
            app:layout_constraintRight_toLeftOf="@+id/app_icon"
            app:layout_constraintTop_toTopOf="@+id/category"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_normal"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@+id/category"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/app_info"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="@+id/app_title"
            app:layout_constraintRight_toRightOf="@+id/app_title"
            app:layout_constraintTop_toBottomOf="@+id/app_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ir.mservices.market.views.AppInfoView
            android:id="@+id/app_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/app_icon"
            app:layout_constraintRight_toLeftOf="@+id/app_icon"
            app:layout_constraintTop_toBottomOf="@+id/category"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ir.mservices.market.views.MyketRatingBar
            android:id="@+id/ratingbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:layout_constraintBottom_toTopOf="@+id/comment"
            app:layout_constraintRight_toRightOf="@+id/app_icon"
            app:layout_constraintTop_toBottomOf="@+id/app_icon"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_medium"
            android:gravity="right"
            android:id="@+id/comment"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_centerHorizontal="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ratingbar"/>
        <ir.mservices.market.views.MyketImageButton
            android:id="@+id/more"
            android:tag="binding_4"
            android:padding="@dimen/space_4"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/app_icon"
            app:srcCompat="@drawable/ic_more_ver"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
