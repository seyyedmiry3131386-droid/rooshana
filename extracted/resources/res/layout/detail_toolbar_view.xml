<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:tag="layout/detail_toolbar_view_0"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/actionbar_size"
    android:paddingStart="@dimen/actionbar_start_space"
    android:paddingEnd="@dimen/actionbar_end_space">
    <ir.mservices.market.views.DownloadProgressBar
        android:id="@+id/download_progress_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:progressDrawable="@drawable/detail_progress_download_white"
        app:layout_constraintBottom_toBottomOf="@+id/download"
        app:layout_constraintEnd_toEndOf="@+id/download"
        app:layout_constraintStart_toStartOf="@+id/download"
        app:layout_constraintTop_toTopOf="@+id/download"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ir.mservices.market.views.SmallFillOvalButton
        android:id="@+id/download"
        android:layout_width="@dimen/detail_toolbar_button_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.SmallEmptyLargeTextOvalButton
        android:id="@+id/pause"
        android:layout_width="@dimen/detail_toolbar_button_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_medium"
        android:ellipsize="end"
        android:id="@+id/app_title"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/margin_default_v2"
        android:layout_marginEnd="@dimen/margin_default_v2"
        app:layout_constraintBottom_toTopOf="@+id/page_title"
        app:layout_constraintEnd_toStartOf="@+id/download"
        app:layout_constraintStart_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/RtlGravity"/>
    <ir.mservices.market.views.MyketNoPaddingTextView
        android:textSize="@dimen/font_size_normal"
        android:ellipsize="end"
        android:id="@+id/page_title"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/margin_default_v2"
        android:layout_marginEnd="@dimen/margin_default_v2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/download"
        app:layout_constraintStart_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toBottomOf="@+id/app_title"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/RtlGravity"/>
    <ir.mservices.market.views.MyketNoPaddingTextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/app_rate"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/margin_default_v2"
        app:layout_constraintStart_toStartOf="@+id/page_title"
        app:layout_constraintTop_toTopOf="@+id/page_title"
        style="@style/RtlGravity"/>
    <ImageView
        android:id="@+id/rate_star"
        android:padding="@dimen/margin_default_v2_quarter"
        android:visibility="visible"
        android:layout_width="@dimen/rate_image_size"
        android:layout_height="@dimen/rate_image_size"
        android:src="@drawable/ic_star_fill"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/app_rate"
        app:layout_constraintStart_toEndOf="@+id/app_rate"
        app:layout_constraintTop_toTopOf="@+id/app_rate"/>
    <ir.mservices.market.views.AppIconView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/detail_toolbar_icon"
        android:layout_height="@dimen/detail_toolbar_icon"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/space_m"
        app:app_framed="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:tag="binding_4"
        android:padding="@dimen/toolbar_back_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_back"/>
</androidx.constraintlayout.widget.ConstraintLayout>
