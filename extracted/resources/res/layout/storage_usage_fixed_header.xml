<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storage_usage_root"
    android:tag="layout/storage_usage_fixed_header_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/storage_usage_header_height"
    android:layoutDirection="locale">
    <View
        android:id="@+id/bg_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/shadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_large"
        android:id="@+id/usage_title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:paddingStart="@dimen/horizontal_space_inner"
        android:layout_marginStart="@dimen/horizontal_space_outer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_4"
        android:layout_marginTop="@dimen/space_8"
        android:max="100"
        android:indeterminate="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/usage_title"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_medium"
        android:id="@+id/apps_count"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:paddingEnd="@dimen/horizontal_space_inner"
        android:layout_marginEnd="@dimen/horizontal_space_outer"
        android:layout_marginVertical="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
    <FrameLayout
        android:id="@+id/sort_clickable"
        android:tag="binding_3"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_4"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:paddingStart="@dimen/horizontal_space_inner"
        android:paddingEnd="@dimen/space_8"
        android:layout_marginStart="@dimen/horizontal_space_outer"
        android:elevation="5dp"
        android:paddingVertical="@dimen/space_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBar">
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_medium"
            android:id="@+id/sort_title"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/space_4"/>
    </FrameLayout>
    <View
        android:id="@+id/shadow"
        android:background="@drawable/toolbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_4"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintTop_toBottomOf="@+id/sort_clickable"/>
</androidx.constraintlayout.widget.ConstraintLayout>
