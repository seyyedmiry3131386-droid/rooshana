<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_custom_list_title_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ir.mservices.market.views.DialogArrowComponent
        android:id="@+id/arrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_large"
        android:id="@+id/description"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_16"
        android:text="@string/profile_list_title_dialog_description"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arrow"
        style="@style/RtlGravity.Center"/>
    <ir.mservices.market.views.MyketInputLayout
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        app:boxBackgroundMode="outline"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description">
        <ir.mservices.market.views.MyketEditText
            android:textSize="@dimen/font_size_large"
            android:ellipsize="end"
            android:id="@+id/input_name"
            android:tag="binding_2"
            android:background="@null"
            android:padding="@dimen/margin_default_v2_oneHalf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/profile_list_title_dialog_input_hint"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:drawablePadding="@dimen/space_8"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:textSelectHandleLeft="@drawable/search_select_handle_left"
            android:textSelectHandleRight="@drawable/search_select_handle_right"
            android:textSelectHandle="@drawable/search_select_handle_middle"
            app:has_background="false"/>
    </ir.mservices.market.views.MyketInputLayout>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/error"
        android:tag="binding_3"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default_v2_double"
        android:layout_marginTop="@dimen/margin_default_v2"
        android:layout_marginRight="@dimen/margin_default_v2_double"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input"/>
    <ir.mservices.market.views.DialogButtonComponent
        android:id="@+id/dialog_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default_v2_double"
        android:layout_marginTop="@dimen/margin_default_v2"
        android:layout_marginRight="@dimen/margin_default_v2_double"
        android:layout_marginBottom="@dimen/margin_default_v2_double"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error"/>
</androidx.constraintlayout.widget.ConstraintLayout>
