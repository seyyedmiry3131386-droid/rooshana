<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/holder_users_empty_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/hintBgLayout"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/empty_icon"
            android:layout_width="@dimen/own_users_empty_icon_size"
            android:layout_height="@dimen/own_users_empty_icon_size"
            android:adjustViewBounds="true"
            app:lottie_loop="false"
            app:lottie_repeatCount="0"
            app:lottie_repeatMode="restart"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_large"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:tag="binding_1"
            android:paddingLeft="@dimen/space_24"
            android:paddingRight="@dimen/space_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            app:bold="true"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_medium"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/message"
            android:tag="binding_2"
            android:paddingLeft="@dimen/space_24"
            android:paddingRight="@dimen/space_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"/>
        <ir.mservices.market.views.BigFillOvalButton
            android:layout_gravity="center"
            android:id="@+id/action_button"
            android:layout_width="@dimen/empty_view_button_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"/>
    </LinearLayout>
</FrameLayout>
