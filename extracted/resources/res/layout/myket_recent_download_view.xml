<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/recent_download_layout_size"
    android:layout_height="@dimen/recent_download_layout_size"
    android:layoutDirection="locale">
    <ir.mservices.market.views.LoadingView
        android:id="@+id/download"
        android:tag="layout/myket_recent_download_view_0"
        android:visibility="gone"
        android:layout_width="@dimen/default_icon_size"
        android:layout_height="@dimen/default_icon_size"
        android:max="100"
        android:progress="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pointer_icon"
        android:tag="layout/myket_recent_download_view_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/download"
        app:layout_constraintEnd_toEndOf="@+id/download"
        app:layout_constraintStart_toStartOf="@+id/download"
        app:layout_constraintTop_toTopOf="@+id/download"
        app:srcCompat="@drawable/ic_pointer_down"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tick_outline_icon"
        android:tag="layout/myket_recent_download_view_2"
        android:visibility="gone"
        android:layout_width="@dimen/default_icon_size"
        android:layout_height="@dimen/default_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/download"
        app:layout_constraintEnd_toEndOf="@+id/download"
        app:layout_constraintStart_toStartOf="@+id/download"
        app:layout_constraintTop_toTopOf="@+id/download"
        app:srcCompat="@drawable/ic_tick_with_outline"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/status_change_animation"
        android:tag="layout/myket_recent_download_view_3"
        android:visibility="gone"
        android:layout_width="@dimen/default_icon_size"
        android:layout_height="@dimen/default_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/download"
        app:layout_constraintEnd_toEndOf="@+id/download"
        app:layout_constraintStart_toStartOf="@+id/download"
        app:layout_constraintTop_toTopOf="@+id/download"
        app:lottie_loop="false"
        app:lottie_repeatCount="0"
        app:lottie_repeatMode="restart"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/badge"
        android:tag="layout/myket_recent_download_view_4"
        android:background="@drawable/badge"
        android:visibility="gone"
        android:layout_width="@dimen/recent_download_badge_size"
        android:layout_height="@dimen/recent_download_badge_size"
        android:layout_marginTop="@dimen/space_xs"
        android:includeFontPadding="false"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/space_xs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
