<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/ibex_fragment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/layout"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/dummy_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ir.mservices.market.version2.manager.player.doubleTap.DoubleTapPlayerView
            android:id="@+id/playerView"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            app:animation_enabled="false"
            app:dtpv_controller="@+id/playerOverlay"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:use_controller="false"/>
        <androidx.media3.ui.PlayerControlView
            android:id="@+id/controller"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            app:animation_enabled="false"
            app:controller_layout_id="@layout/ibex_controller"
            app:layout_constraintBottom_toBottomOf="@+id/playerView"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/playerView"/>
        <ir.mservices.market.version2.manager.player.doubleTap.customPlayer.PlayerOverlay
            android:id="@+id/playerOverlay"
            android:tag="binding_3"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:animateLayoutChanges="true"
            app:layout_constraintBottom_toBottomOf="@+id/playerView"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/playerView"
            app:player_playerView="@+id/playerView"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/popUpGuideline"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.84"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ir.mservices.market.views.TrailerFinishedPlayingView
        android:id="@+id/trailer_finished_playing_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
