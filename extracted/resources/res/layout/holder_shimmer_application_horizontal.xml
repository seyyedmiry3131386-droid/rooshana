<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/default_view"
    android:tag="layout/holder_shimmer_application_horizontal_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ir.mservices.market.views.AlphaAnimationView
        android:id="@+id/default_application_icon"
        android:layout_width="@dimen/app_list_icon_size"
        android:layout_height="@dimen/app_list_icon_size"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:layout_marginStart="@dimen/horizontal_space_inner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.AlphaAnimationView
        android:id="@+id/default_application_name"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_xl"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/horizontal_space_inner"
        app:layout_constraintBottom_toTopOf="@+id/default_application_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/default_application_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ir.mservices.market.views.AlphaAnimationView
        android:id="@+id/default_application_description"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/horizontal_space_inner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/default_application_icon"
        app:layout_constraintTop_toBottomOf="@+id/default_application_name"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
