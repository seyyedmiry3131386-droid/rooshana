<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_step_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <View
        android:id="@+id/right_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/image_indicator"
        app:layout_constraintEnd_toStartOf="@+id/left_line"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_indicator"/>
    <View
        android:id="@+id/left_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/image_indicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/right_line"
        app:layout_constraintTop_toTopOf="@+id/image_indicator"/>
    <ImageView
        android:id="@+id/image_indicator"
        android:layout_width="@dimen/space_32"
        android:layout_height="@dimen/space_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_medium"
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        app:bold="true"
        app:layout_constraintEnd_toEndOf="@+id/image_indicator"
        app:layout_constraintStart_toStartOf="@+id/image_indicator"
        app:layout_constraintTop_toBottomOf="@+id/image_indicator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
