<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:tag="layout-w960dp/home_banner_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/horizontal_space_outer"
    android:layout_marginRight="@dimen/horizontal_space_outer"
    android:layout_marginHorizontal="@dimen/horizontal_space_outer">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/banner_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:layout_marginVertical="@dimen/space_12"
        app:cardCornerRadius="@dimen/default_image_corner_radius">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/banner_icon"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/single_movie_banner_height"
            android:scaleType="fitCenter"/>
    </androidx.cardview.widget.CardView>
</FrameLayout>
