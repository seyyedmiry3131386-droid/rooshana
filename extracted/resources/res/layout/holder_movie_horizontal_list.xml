<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:tag="layout/holder_movie_horizontal_list_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_row"
        android:tag="binding_1"
        android:paddingLeft="@dimen/horizontal_space_outer"
        android:paddingTop="@dimen/space_m"
        android:paddingRight="@dimen/horizontal_space_outer"
        android:paddingBottom="@dimen/space_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/horizontal_space_outer"
        android:paddingVertical="@dimen/space_m">
        <ir.mservices.market.views.AlphaAnimationView
            android:id="@+id/header_shimmer"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_m"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_xl"
            android:layout_marginLeft="@dimen/horizontal_space_inner"
            android:layout_marginRight="@dimen/horizontal_space_inner"
            android:paddingStart="@dimen/horizontal_space_outer"
            android:paddingEnd="@dimen/horizontal_space_outer"
            android:layout_marginHorizontal="@dimen/horizontal_space_inner"
            android:paddingVertical="@dimen/space_m"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_huge"
            android:ellipsize="end"
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/horizontal_space_inner"
            app:bold="true"
            app:layout_constraintEnd_toStartOf="@+id/section_more_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ir.mservices.market.views.SmallBoldTextButton
            android:id="@+id/section_more_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_title_all"
            android:layout_marginEnd="@dimen/horizontal_space_inner"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/header_title"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ir.mservices.market.views.HorizontalRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"/>
</LinearLayout>
