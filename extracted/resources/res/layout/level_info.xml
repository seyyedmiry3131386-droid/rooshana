<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/level_info_0"
    android:paddingLeft="@dimen/horizontal_space_outer"
    android:paddingTop="@dimen/space_xl"
    android:paddingRight="@dimen/horizontal_space_outer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/horizontal_space_outer">
    <ir.mservices.market.views.AvatarImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/header_avatar_size"
        android:layout_height="@dimen/header_avatar_size"
        android:layout_marginLeft="@dimen/horizontal_space_inner"
        android:layout_marginRight="@dimen/horizontal_space_inner"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="@dimen/horizontal_space_inner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/level_icon_background"
        android:layout_width="@dimen/level_item_level_size"
        android:layout_height="@dimen/level_item_level_size"
        android:layout_marginLeft="@dimen/horizontal_space_inner"
        android:layout_marginTop="@dimen/level_item_level_margin"
        android:layout_marginRight="@dimen/horizontal_space_inner"
        android:layout_marginHorizontal="@dimen/horizontal_space_inner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        app:srcCompat="@drawable/ic_pentagon_back"/>
    <ImageView
        android:id="@+id/level_icon"
        android:layout_width="@dimen/level_item_level_size"
        android:layout_height="@dimen/level_item_level_size"
        app:layout_constraintBottom_toBottomOf="@+id/level_icon_background"
        app:layout_constraintEnd_toEndOf="@+id/level_icon_background"
        app:layout_constraintStart_toStartOf="@+id/level_icon_background"
        app:layout_constraintTop_toTopOf="@+id/level_icon_background"
        app:srcCompat="@drawable/ic_pentagon_front"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_huge"
        android:gravity="center"
        android:id="@+id/level"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bold="true"
        app:layout_constraintBottom_toBottomOf="@+id/level_icon_background"
        app:layout_constraintEnd_toEndOf="@+id/level_icon_background"
        app:layout_constraintStart_toStartOf="@+id/level_icon_background"
        app:layout_constraintTop_toTopOf="@+id/level_icon_background"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_large"
        android:id="@+id/title"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/horizontal_space_inner"
        android:layout_marginTop="@dimen/level_item_name_margin_top"
        android:layout_marginRight="@dimen/horizontal_space_inner"
        android:layout_marginHorizontal="@dimen/horizontal_space_inner"
        app:bold="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/level_icon_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
