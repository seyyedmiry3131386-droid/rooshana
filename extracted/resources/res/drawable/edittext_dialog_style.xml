<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:right="-2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <padding
                android:left="@dimen/margin_default_v2"
                android:top="@dimen/margin_default_v2_oneHalf"
                android:right="@dimen/margin_default_v2"
                android:bottom="@dimen/margin_default_v2_oneHalf"/>
            <stroke
                android:width="1dp"
                android:color="@color/white"/>
            <solid android:color="@color/transparent"/>
        </shape>
    </item>
</layer-list>
