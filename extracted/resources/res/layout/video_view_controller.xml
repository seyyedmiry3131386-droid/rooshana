<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controller_layout"
    android:tag="layout/video_view_controller_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="@dimen/ripple_elevation">
    <View
        android:id="@+id/bottom_view"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/play"
        android:tag="@string/movie_play"
        android:padding="@dimen/space_16"
        android:layout_width="@dimen/movie_player_icon_size_big"
        android:layout_height="@dimen/movie_player_icon_size_big"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_pause"/>
    <ImageView
        android:id="@+id/fullscreen"
        android:padding="@dimen/margin_default_v2"
        android:layout_width="@dimen/movie_player_icon_size_small"
        android:layout_height="@dimen/movie_player_icon_size_small"
        android:layout_marginRight="@dimen/margin_default_v2_double"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/exo_progress"
        app:layout_constraintLeft_toRightOf="@+id/exo_progress"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exo_progress"
        app:srcCompat="@drawable/ic_fullscreen"/>
    <androidx.media3.ui.DefaultTimeBar
        android:layout_gravity="center_vertical"
        android:id="@+id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default_v2_double"
        android:layout_marginBottom="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/fullscreen"/>
</androidx.constraintlayout.widget.ConstraintLayout>
