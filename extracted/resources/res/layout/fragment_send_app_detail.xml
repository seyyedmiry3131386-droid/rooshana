<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_send_app_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ir.mservices.market.views.AppIconView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/avatar_size_small"
        android:layout_height="@dimen/avatar_size_small"
        android:layout_marginTop="@dimen/margin_default_v2"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/margin_default_v2_double"
        app:app_framed="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_large"
        android:ellipsize="end"
        android:id="@+id/app_name"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default_v2"
        android:layout_marginRight="@dimen/margin_default_v2"
        android:singleLine="true"
        android:textAlignment="viewStart"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/info"
        app:layout_constraintEnd_toStartOf="@+id/install"
        app:layout_constraintStart_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toTopOf="@+id/app_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_small"
        android:textStyle="bold"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/info"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default_v2"
        android:layout_marginRight="@dimen/margin_default_v2"
        android:singleLine="true"
        android:drawablePadding="@dimen/margin_default_v2_half"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@+id/app_icon"
        app:layout_constraintEnd_toStartOf="@+id/install"
        app:layout_constraintStart_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toBottomOf="@+id/app_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ir.mservices.market.views.PikaReceiveView
        android:id="@+id/install"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_default_v2_double"
        app:layout_constraintBottom_toBottomOf="@+id/app_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/app_icon"/>
    <ir.mservices.market.views.BigFillRectangleButton
        android:textSize="@dimen/font_size_medium"
        android:id="@+id/sendBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_default_v2_double"
        android:layout_marginStart="@dimen/margin_default_v2_double"
        android:layout_marginEnd="@dimen/margin_default_v2_double"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:pb_state="button"
        app:pb_text="@string/send_another_app"/>
</androidx.constraintlayout.widget.ConstraintLayout>
