<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/holder_welcome_name_0"
    android:paddingLeft="@dimen/horizontal_space_outer"
    android:paddingRight="@dimen/horizontal_space_outer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/horizontal_space_outer">
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_large"
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_name_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketInputLayout
        android:id="@+id/myketInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:boxBackgroundMode="outline"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ir.mservices.market.views.MyketEditText
            android:textSize="@dimen/font_size_large"
            android:id="@+id/username"
            android:tag="binding_2"
            android:background="@null"
            android:padding="@dimen/space_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:hint="@string/name"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:drawablePadding="@dimen/space_8"
            android:layout_below="@+id/txt_desc"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:textSelectHandleLeft="@drawable/search_select_handle_left"
            android:textSelectHandleRight="@drawable/search_select_handle_right"
            android:textSelectHandle="@drawable/search_select_handle_middle"
            android:importantForAutofill="no"
            app:has_background="false"/>
    </ir.mservices.market.views.MyketInputLayout>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_normal"
        android:id="@+id/error"
        android:tag="binding_3"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/myketInputLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
