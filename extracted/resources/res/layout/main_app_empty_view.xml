<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty_view"
    android:tag="layout/main_app_empty_view_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_navigation_height"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/actionbar_size"
        android:layout_centerInParent="true">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/empty_icon"
            android:layout_width="@dimen/empty_image_size"
            android:layout_height="@dimen/empty_image_size"
            app:lottie_loop="false"
            app:lottie_repeatCount="0"
            app:lottie_repeatMode="restart"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_large"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/empty_title"
            android:tag="binding_1"
            android:paddingLeft="@dimen/space_24"
            android:paddingRight="@dimen/space_24"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="@string/app_not_found"
            app:bold="true"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_medium"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/empty_message"
            android:tag="binding_2"
            android:paddingLeft="@dimen/space_24"
            android:paddingRight="@dimen/space_24"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"/>
    </LinearLayout>
</FrameLayout>
