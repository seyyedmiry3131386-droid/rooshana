<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clickable_layout"
    android:tag="layout/holder_movie_single_movie_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_m"
    android:layout_marginBottom="@dimen/space_m">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ir.mservices.market.views.ScreenshotView
            android:id="@+id/banner"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_large"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/title"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_default_v2_oneHalf"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/margin_default_v2_oneHalf"
            android:layout_marginEnd="@dimen/margin_default_v2_oneHalf"
            app:bold="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/banner"
            app:layout_constraintTop_toTopOf="parent"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_normal"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_default_v2_quarter"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/margin_default_v2_oneHalf"
            android:layout_marginEnd="@dimen/margin_default_v2_oneHalf"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/secondary_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/banner"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_small"
            android:ellipsize="end"
            android:id="@+id/secondary_title"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_default_v2_half"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/margin_default_v2_oneHalf"
            android:layout_marginEnd="@dimen/margin_default_v2_oneHalf"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/banner"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
        <ir.mservices.market.views.MyketTextView
            android:textSize="@dimen/font_size_normal"
            android:ellipsize="end"
            android:id="@+id/description"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_default_v2_triple"
            android:maxLines="4"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/margin_default_v2_oneHalf"
            android:layout_marginEnd="@dimen/margin_default_v2_oneHalf"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/banner"
            app:layout_constraintTop_toBottomOf="@+id/secondary_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
