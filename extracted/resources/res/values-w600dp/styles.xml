<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyDefaultStyle.TabletDialog" parent="@style/Theme.Material3.DayNight.Dialog">
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="TabIndicatorGravity" parent="">
        <item name="android:background">@color/transparent</item>
        <item name="android:layout_marginStart">@dimen/horizontal_space_outer</item>
        <item name="tabGravity">fill</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabMode">scrollable</item>
        <item name="tabPaddingEnd">@dimen/space_16</item>
        <item name="tabPaddingStart">@dimen/space_16</item>
        <item name="tabTextAppearance">@style/MyDefaultStyle.TabTextAppearance</item>
    </style>
</resources>
