<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:tag="layout/update_card_myket_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/app_card"
            android:tag="binding_1"
            android:paddingTop="@dimen/space_s"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/myket_new_version_icon"
                    android:layout_width="@dimen/space_20"
                    android:layout_height="@dimen/space_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_update_myket"/>
                <ir.mservices.market.views.MyketTextView
                    android:textSize="@dimen/font_size_medium"
                    android:id="@+id/myket_new_version_title"
                    android:tag="binding_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/myket_new_version_update_title"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="@dimen/space_4"
                    app:bold="true"
                    app:layout_constraintBottom_toBottomOf="@+id/myket_new_version_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/myket_new_version_icon"
                    app:layout_constraintTop_toTopOf="@+id/myket_new_version_icon"/>
                <ir.mservices.market.views.AppIconView
                    android:id="@+id/app_icon"
                    android:layout_width="@dimen/app_icon_size"
                    android:layout_height="@dimen/app_icon_size"
                    android:layout_marginTop="@dimen/space_8"
                    android:scaleType="fitCenter"
                    android:paddingEnd="@dimen/space_8"
                    app:app_framed="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/myket_new_version_icon"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/app_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_8"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginRight="@dimen/space_8"
                    android:layout_marginHorizontal="@dimen/space_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/download_layout"
                    app:layout_constraintStart_toEndOf="@+id/app_icon"
                    app:layout_constraintTop_toBottomOf="@+id/myket_new_version_icon">
                    <ir.mservices.market.views.MyketTextView
                        android:textSize="@dimen/font_size_large"
                        android:ellipsize="end"
                        android:id="@+id/app_name"
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textAlignment="viewStart"/>
                    <ir.mservices.market.views.MyketTextView
                        android:textSize="@dimen/font_size_normal"
                        android:id="@+id/size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:textAlignment="viewStart"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/arrow_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    app:layout_constraintBottom_toBottomOf="@+id/download_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/download_layout">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/app_more"
                        android:tag="binding_4"
                        android:padding="@dimen/space_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_arrow_down"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/download_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/app_icon"
                    app:layout_constraintEnd_toStartOf="@+id/arrow_layout"
                    app:layout_constraintTop_toTopOf="@+id/app_icon">
                    <ir.mservices.market.views.FastDownloadView
                        android:layout_gravity="center"
                        android:id="@+id/fast_download_view"
                        android:focusable="true"
                        android:clickable="true"
                        android:duplicateParentState="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/whats_new_layout"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ir.mservices.market.views.MyketTextView
                android:textSize="@dimen/font_size_medium"
                android:layout_gravity="left"
                android:id="@+id/whats_new_title"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whatsnew"
                app:bold="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ir.mservices.market.views.MyketTextView
                android:textSize="@dimen/font_size_medium"
                android:id="@+id/whats_new_text"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/whats_new_title"/>
            <ir.mservices.market.views.MyketTextView
                android:textSize="@dimen/font_size_medium"
                android:id="@+id/ver_from"
                android:tag="binding_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/version_from"
                app:layout_constraintTop_toBottomOf="@+id/whats_new_text"/>
            <ir.mservices.market.views.MyketTextView
                android:textSize="@dimen/font_size_medium"
                android:id="@+id/ver_to"
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/version_to"
                app:layout_constraintTop_toBottomOf="@+id/ver_from"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ir.mservices.market.views.UpdateRatingView
            android:id="@+id/rating_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
