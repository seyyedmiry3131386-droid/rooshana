<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:text="URL/ID:"
        android:layout_alignBaseline="@+id/etUrl"/>
    <TextView
        android:id="@+id/tFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:text="File/Result:"
        android:layout_alignBaseline="@+id/etFile"/>
    <EditText
        android:id="@+id/etUrl"
        android:background="#dddddd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:ems="10"
        android:layout_alignLeft="@+id/etFile"
        android:layout_alignParentRight="true"/>
    <EditText
        android:id="@+id/etFile"
        android:background="#dddddd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_toRightOf="@+id/tFile"
        android:layout_below="@+id/etUrl"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/etFile">
        <Button
            android:textSize="20sp"
            android:id="@+id/bAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="+"
            android:layout_weight="10"/>
        <Button
            android:textSize="20sp"
            android:id="@+id/bStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="I&gt;"
            android:layout_weight="10"/>
        <Button
            android:textSize="20sp"
            android:id="@+id/bPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="II"
            android:layout_weight="10"/>
        <Button
            android:textSize="20sp"
            android:id="@+id/bCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="X"
            android:layout_weight="10"/>
        <Button
            android:textSize="20sp"
            android:id="@+id/bRemove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_weight="10"/>
        <Button
            android:textSize="20sp"
            android:id="@+id/bUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="^"
            android:layout_weight="10"/>
        <Button
            android:textSize="20sp"
            android:id="@+id/bDown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="v"
            android:layout_weight="10"/>
    </LinearLayout>
    <ScrollView
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/lButtons">
        <TextView
            android:textSize="17sp"
            android:id="@+id/tDownloads"
            android:background="#cccccc"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hello_world"
            android:shadowColor="#ffffffff"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="2"/>
    </ScrollView>
</RelativeLayout>
