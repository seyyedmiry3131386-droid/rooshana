<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:tag="layout/holder_suggest_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_m"
    android:layout_marginBottom="@dimen/space_m"
    android:paddingStart="@dimen/horizontal_space_inner"
    android:paddingEnd="@dimen/horizontal_space_inner">
    <ir.mservices.market.views.AvatarImageView
        android:id="@+id/imagecell"
        android:layout_width="@dimen/app_icon_size"
        android:layout_height="@dimen/app_icon_size"
        android:scaleType="fitXY"
        app:circle="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_large"
        android:ellipsize="end"
        android:id="@+id/textTitle"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_button"
        app:layout_constraintStart_toEndOf="@+id/imagecell"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.SmallEmptyMediumTextOvalButton
        android:ellipsize="end"
        android:id="@+id/view_button"
        android:layout_width="@dimen/download_button_min_width"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/download_button_min_width"
        android:minWidth="@dimen/download_button_min_width"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAlignment="center"
        android:outlineProvider="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pb_text="@string/more_clickable_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
