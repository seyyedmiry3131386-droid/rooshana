<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/holder_movie_season_title_0"
    android:paddingLeft="@dimen/horizontal_space_inner"
    android:paddingRight="@dimen/horizontal_space_inner"
    android:paddingBottom="@dimen/space_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/horizontal_space_outer"
    android:layout_marginTop="@dimen/space_16"
    android:layout_marginRight="@dimen/horizontal_space_outer"
    android:layout_marginHorizontal="@dimen/horizontal_space_outer"
    android:paddingHorizontal="@dimen/horizontal_space_inner">
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_huge"
        android:id="@+id/label"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bold="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_medium"
        android:gravity="center"
        android:id="@+id/title"
        android:tag="binding_2"
        android:paddingLeft="@dimen/space_12"
        android:paddingRight="@dimen/space_12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/chip_view_height"
        android:minWidth="@dimen/chip_view_height"
        android:drawablePadding="@dimen/space_8"
        android:paddingHorizontal="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
