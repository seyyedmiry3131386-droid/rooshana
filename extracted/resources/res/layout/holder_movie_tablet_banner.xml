<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/holder_movie_tablet_banner_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/clickable_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ir.mservices.market.views.ScreenshotView
        android:id="@+id/blur_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/blur_banner_foreground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/blur_banner"
        app:layout_constraintEnd_toEndOf="@+id/blur_banner"
        app:layout_constraintStart_toStartOf="@+id/blur_banner"
        app:layout_constraintTop_toTopOf="@+id/blur_banner"/>
    <ir.mservices.market.views.ScreenshotView
        android:id="@+id/banner"
        android:layout_width="@dimen/single_movie_banner_width"
        android:layout_height="@dimen/single_movie_banner_height"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/blur_banner"
        app:layout_constraintStart_toStartOf="@+id/blur_banner"
        app:layout_constraintTop_toTopOf="@+id/blur_banner"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_huge"
        android:ellipsize="end"
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:maxLines="2"
        android:lines="2"
        android:textAlignment="viewStart"
        android:paddingEnd="@dimen/space_12"
        android:layout_marginStart="@dimen/space_12"
        app:bold="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/secondary_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/banner"
        app:layout_constraintTop_toTopOf="@+id/banner"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ir.mservices.market.views.MyketTextView
        android:textSize="@dimen/font_size_medium"
        android:ellipsize="end"
        android:id="@+id/secondary_title"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:paddingEnd="@dimen/space_12"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toTopOf="@+id/action_click"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/banner"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <FrameLayout
        android:id="@+id/action_click"
        android:tag="binding_3"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/banner"
        app:layout_constraintTop_toBottomOf="@+id/secondary_title"
        app:layout_constraintVertical_chainStyle="packed">
        <ir.mservices.market.views.SmallBoldTextButton
            android:ellipsize="end"
            android:id="@+id/action"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:paddingEnd="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="@+id/banner"
            app:layout_constraintStart_toEndOf="@+id/banner"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
