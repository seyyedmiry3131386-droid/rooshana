<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background"
        android:tag="layout/view_custom_list_search_0"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_list_search_input_height"
        android:layout_marginLeft="@dimen/horizontal_space_inner"
        android:layout_marginRight="@dimen/horizontal_space_inner"
        android:layout_marginHorizontal="@dimen/horizontal_space_inner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ir.mservices.market.views.MyketEditText
        android:textSize="@dimen/font_size_large"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/search_input"
        android:tag="layout/view_custom_list_search_1"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/profile_list_search"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:textSelectHandleLeft="@drawable/search_select_handle_left"
        android:textSelectHandleRight="@drawable/search_select_handle_right"
        android:textSelectHandle="@drawable/search_select_handle_middle"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_12"
        app:has_background="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/clear"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/clear"
        android:tag="layout/view_custom_list_search_2"
        android:padding="@dimen/space_m"
        android:layout_width="@dimen/custom_list_search_input_height"
        android:layout_height="@dimen/custom_list_search_input_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_close"/>
</merge>
