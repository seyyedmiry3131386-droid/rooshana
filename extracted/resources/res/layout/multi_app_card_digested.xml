<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/multi_app_card_digested_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/space"
        android:layout_width="@dimen/item_space"
        android:layout_height="1dp"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/application_layout"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/horizontal_space_inner"
        android:paddingEnd="@dimen/horizontal_space_inner"
        android:layout_toStartOf="@+id/space"
        android:layout_alignParentStart="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ir.mservices.market.views.AppIconView
                android:id="@+id/application_icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m"
                app:app_framed="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ir.mservices.market.views.MyketTextView
                android:textSize="@dimen/font_size_medium"
                android:ellipsize="end"
                android:id="@+id/application_name"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_12"
                app:layout_constraintBottom_toTopOf="@+id/application_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/application_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <ir.mservices.market.views.MyketAdInfoView
                android:id="@+id/ad_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="@+id/application_description"
                app:layout_constraintStart_toEndOf="@+id/application_icon"
                app:layout_constraintTop_toBottomOf="@+id/application_name"/>
            <ir.mservices.market.views.MyketTextView
                android:textSize="@dimen/font_size_normal"
                android:ellipsize="end"
                android:id="@+id/application_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ad_info"
                app:layout_constraintTop_toBottomOf="@+id/application_name"
                app:layout_constraintVertical_chainStyle="packed"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</RelativeLayout>
